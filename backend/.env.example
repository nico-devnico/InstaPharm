# Copier vers .env et renseigner
PORT=3001
NODE_ENV=development

# Supabase (API + Auth JWT)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# PostgreSQL direct (transactions / FOR UPDATE) — Connection string Supabase
# Dashboard → Project Settings → Database → URI
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# CORS — origines Flutter web / outils
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Fraîcheur stock (minutes) — au-delà, is_stale = true
STOCK_STALE_MINUTES_MANUAL=1440
STOCK_STALE_MINUTES_SYNC=360

# Durée réservation (minutes)
STOCK_RESERVATION_MINUTES=20
